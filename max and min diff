#include <iostream>
using namespace std;

int main() {
    int n;
    cin >> n;

    int arr[n];

    for (int i = 0; i < n; i++)
        cin >> arr[i];

    int minElement = arr[0];
    int maxDifference = 0;

    for (int i = 1; i < n; i++) {
        maxDifference = max(maxDifference, arr[i] - minElement);

        if (arr[i] < minElement)
            minElement = arr[i];
    }

    cout << "Maximum difference = " << maxDifference;

    return 0;
}
