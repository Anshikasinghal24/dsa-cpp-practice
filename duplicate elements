#include <iostream>
#include <unordered_set>
using namespace std;

int main() {
    int n;
    cin >> n;

    int arr[n];

    for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }

    unordered_set<int> seen;
    unordered_set<int> duplicates;

    for (int i = 0; i < n; i++) {
        if (seen.find(arr[i]) != seen.end()) {
            duplicates.insert(arr[i]);
        } else {
            seen.insert(arr[i]);
        }
    }

    cout << "Duplicate elements: ";

    for (int num : duplicates) {
        cout << num << " ";
    }

    return 0;
}
