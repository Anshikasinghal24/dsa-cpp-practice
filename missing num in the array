#include <iostream>
using namespace std;

int main() {
    int n;
    cin >> n;

    int arr[n - 1];

    for (int i = 0; i < n - 1; i++) {
        cin >> arr[i];
    }

    int expectedSum = n * (n + 1) / 2;
    int actualSum = 0;

    for (int i = 0; i < n - 1; i++) {
        actualSum = actualSum + arr[i];
    }

    int missing = expectedSum - actualSum;

    cout << "Missing number = " << missing;

    return 0;
}
